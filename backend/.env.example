NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tuyen_dung_ai
DB_USER=root
DB_PASSWORD=
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
DB_POOL_EVICT_MS=1000

CV_UPLOAD_MAX_BYTES=5242880

REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=tuyen_dung_ai:development:

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=TopCV <no-reply@example.com>

GOOGLE_CLIENT_ID=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Ollama chạy cục bộ, miễn phí và chỉ nhận nội dung CV do backend lấy từ hệ thống.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
AI_REQUEST_TIMEOUT_MS=120000
AI_CV_MAX_CHARACTERS=30000

# Tùy chọn trả phí: chỉ dùng khi AI_PROVIDER=claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_WINDOW_MS=60000
REFRESH_RATE_LIMIT_MAX=30
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
EMAIL_VERIFICATION_RATE_LIMIT_WINDOW_MS=900000
EMAIL_VERIFICATION_RATE_LIMIT_MAX=5
