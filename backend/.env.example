NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tuyen_dung_ai
DB_USER=root
DB_PASSWORD=
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
DB_POOL_EVICT_MS=1000

CV_UPLOAD_MAX_BYTES=5242880

# S3-compatible storage (AWS S3, MinIO, Cloudflare R2, TOS S3 gateway...)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=ap-southeast-1
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_PRESIGNED_EXPIRES_SECONDS=900

REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=tuyen_dung_ai:development:

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Tuyen Dung Thong Minh <no-reply@example.com>

GOOGLE_CLIENT_ID=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_WINDOW_MS=60000
REFRESH_RATE_LIMIT_MAX=30
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
EMAIL_VERIFICATION_RATE_LIMIT_WINDOW_MS=900000
EMAIL_VERIFICATION_RATE_LIMIT_MAX=5
