{
  "name": "tuyen-dung-ai-backend",
  "version": "1.0.0",
  "description": "Backend for AI-powered recruitment graduation project",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "clean": "rimraf dist && mkdir dist",
    "clean-log": "rimraf logs && mkdir logs",
    "build": "yarn run clean && babel app --out-dir dist && ncp app/template dist/template",
    "start": "env-cmd nodemon --delay 500ms --trace-warnings --exec babel-node app/server.js",
    "serve": "node dist/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "clear-top-up-cache": "env-cmd babel-node app/scripts/clear-top-up-package-cache.js",
    "test": "mocha --recursive --timeout 100000 --exit",
    "coverage": "nyc yarn test && nyc report --reporter=text-lcov",
    "minify": "node script/minify.cjs",
    "prod": "yarn run build && yarn run minify",
    "prod-local": "rimraf /usr/projects/coco/backend && mkdir -p /usr/projects/coco/backend && yarn run prod && cp -r dist node_modules /usr/projects/coco/backend",
    "scanner": "npx sonarqube-scanner"
  },
  "keywords": [
    "backend"
  ],
  "repository": {
    "type": "git",
    "url": ""
  },
  "engines": {
    "node": ">=24"
  },
  "author": "Peacom Team",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/client-sesv2": "^3.946.0",
    "@aws-sdk/s3-presigned-post": "^3.1112.0",
    "@aws-sdk/s3-request-presigner": "^3.1112.0",
    "@bull-board/api": "^6.14.2",
    "@bull-board/express": "^6.14.2",
    "@peacom/core": "^3.0.6",
    "@peacom/model": "^3.0.36",
    "bcryptjs": "^3.0.3",
    "bignumber.js": "^9.3.1",
    "body-parser": "^2.2.1",
    "bullmq": "^5.76.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.8.2",
    "json-bignumber": "^1.1.1",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "md5": "^2.3.0",
    "morgan": "^1.10.1",
    "mysql2": "^3.15.3",
    "nodemailer": "^7.0.11",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "qrcode": "^1.5.4",
    "query-string": "^9.3.1",
    "rate-limit-redis": "^5.0.0",
    "sequelize": "^6.37.7",
    "sharp": "^0.34.4",
    "speakeasy": "^2.0.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.5",
    "@babel/eslint-parser": "^7.28.4",
    "@babel/eslint-plugin": "^7.27.1",
    "@babel/node": "^7.28.0",
    "@babel/preset-env": "^7.28.5",
    "@babel/register": "^7.28.3",
    "@eslint/js": "^9.39.1",
    "@passwordless-id/webauthn": "^2.3.1",
    "chai": "^6.2.1",
    "chai-http": "^5.1.2",
    "env-cmd": "^11.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "mocha": "^11.7.5",
    "ncp": "^2.0.0",
    "nodemon": "^3.1.11",
    "nyc": "^17.1.0",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "sequelize-cli": "^6.6.3",
    "terser": "^5.44.1"
  },
  "nyc": {
    "_comment": "Purpose of this part: to do code coverage within Mocha/Chai using Istanbul",
    "register": "babel-register",
    "include": [
      "app/**/*.js"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/test/**",
      "**/coverage/**"
    ],
    "all": true
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
